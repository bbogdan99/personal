package UIManager;

import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;

import Matrix.Matrix4;

public class ReflectObjectButton extends JButton
{
	private int index;
	public ReflectButton(String text)
	{
		switch (text)
		{
		case "X":
			setText("Reflect on X");
			this.addActionListener(new ActionListener() 
			{
				@Override
				public void actionPerformed(ActionEvent e) 
				{
					double[] list = new double[9];
					list = scene.getIndexForObject().getTRS().decomposeTRS();
					Matrix4 newTRS = new Matrix4(list[0], list[1], list[2], list[6], list[7], list[8], -list[3], list[4], list[5]);
					scene.getIndexForObject().setTRS(newTRS);
				}
			});
			break;
		case "Y":
			setText("Reflect on Y");
			this.addActionListener(new ActionListener() 
			{
				@Override
				public void actionPerformed(ActionEvent e) 
				{
					double[] list = new double[9];
					list = scene.getIndexForObject().getTRS().decomposeTRS();
					Matrix4 newTRS = new Matrix4(list[0], list[1], list[2], list[6], list[7], list[8], list[3], -list[4], list[5]);
					scene.getIndexForObject().setTRS(newTRS);
				}
			});
			break;
		case "Z":
			setText("Reflect on Z");
			this.addActionListener(new ActionListener() 
			{
				@Override
				public void actionPerformed(ActionEvent e) 
				{
					double[] list = new double[9];
					list = scene.getIndexForObject().getTRS().decomposeTRS();
					Matrix4 newTRS = new Matrix4(list[0], list[1], list[2], list[6], list[7], list[8], list[3], list[4], -list[5]);
					scene.getIndexForObject().setTRS(newTRS);
				}
			});
			break;
		default:
			setText("Incorrect axis (input must be X, Y or Z)");
			break;
		}
		
	}
	
	public int getIndexForObject(){return index;}
}
