package UIManager;

import java.awt.Color;
import java.awt.FlowLayout;
import java.awt.Font;

import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JTextField;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import javax.swing.text.BadLocationException;

import Matrix.Matrix4;
import ThreeDimensionals.Object3D;
import World.Scene;

public class ObjectOptions extends JPanel
{
	Object3D obj;
	Scene scene;
	JPanel renderPanel;
	
	public ObjectOptions(Scene scene)
	{
		obj = new Object3D();
		this.scene = scene;

        setFocusable(false);
	}
	
	
	
	public void showDisabled()
	{
		var viewLabel = new JLabel("<html>Viewing: </html>"); 
		
		viewLabel.setFont(new Font("Serif", Font.PLAIN, 14));
        viewLabel.setForeground(new Color(50, 50, 25));
        
        add(viewLabel);
        
		setFocusable(false);
	}
	
	public void showOptions()
	{
		setFocusable(true);
		
		String type = obj.getClass().getTypeName();
		var viewLabel = new JLabel("<html>Viewing: " + type); 
		
		viewLabel.setFont(new Font("Serif", Font.PLAIN, 14));
        viewLabel.setForeground(new Color(50, 50, 25));
        
        add(viewLabel);
		
		double[] attTSR = obj.getTRS().decomposeTRS();
		double[] material = {obj.getMaterial().getKa(), obj.getMaterial().getKd(), obj.getMaterial().getKs(), obj.getMaterial().getB()};
		
		var scaleXLabel = new JLabel("<html>Scale x: ");
		scaleXLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		scaleXLabel.setForeground(new Color(50, 50, 25));
		
		var modifyScaleX = new JTextField(11);
		modifyScaleX.setText(String.valueOf(attTSR[3]));
		modifyScaleX.addActionListener(e -> {
			try
			{
				double x = Double.parseDouble(modifyScaleX.getText());
				modifyScaleX.setText(String.valueOf(x));
				
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						x, attTSR[4], attTSR[5]);
				attTSR[3] = x;
				obj.getTRS().setValues(temp.getValues());
			} catch (Exception ex)
			{
				ex.printStackTrace();
				modifyScaleX.setText("1.0");
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						1.0, attTSR[4], attTSR[5]);
				attTSR[3] = 1.0;
				obj.getTRS().setValues(temp.getValues());
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		
		JPanel scaleXRow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		scaleXRow.add(scaleXLabel);
		scaleXRow.add(modifyScaleX);
		
		add(scaleXRow);
		
		var scaleYLabel = new JLabel("<html>Scale y: ");
		scaleYLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		scaleYLabel.setForeground(new Color(50, 50, 25));

		var modifyScaleY = new JTextField(11);
		modifyScaleY.setText(String.valueOf(attTSR[4]));
		modifyScaleY.addActionListener( e -> {
			try
			{
				double y = Double.parseDouble(modifyScaleY.getText());
				modifyScaleY.setText(String.valueOf(y));
				
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						attTSR[3], y, attTSR[5]);
				attTSR[4] = y;
				obj.getTRS().setValues(temp.getValues());
			} catch (Exception ex)
			{
				ex.printStackTrace();
				modifyScaleY.setText("1.0");
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						attTSR[3], 1.0, attTSR[5]);
				attTSR[4] = 1.0;
				obj.getTRS().setValues(temp.getValues());
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		
		JPanel scaleYRow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		scaleYRow.add(scaleYLabel);
		scaleYRow.add(modifyScaleY);
		
		add(scaleYRow);
		
		var scaleZLabel = new JLabel("<html>Scale z: ");
		scaleZLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		scaleZLabel.setForeground(new Color(50, 50, 25));
		
		var modifyScaleZ = new JTextField(11);
		modifyScaleZ.setText(String.valueOf(attTSR[5]));
		modifyScaleZ.addActionListener( e -> {
			try
			{
				double z = Double.parseDouble(modifyScaleZ.getText());
				modifyScaleZ.setText(String.valueOf(z));
				
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						attTSR[3], attTSR[4], z);
				attTSR[5] = z;
				obj.getTRS().setValues(temp.getValues());
			} catch (Exception ex)
			{
				ex.printStackTrace();
				modifyScaleZ.setText("1.0");
				Matrix4 temp = new Matrix4(attTSR[0], attTSR[1], attTSR[2],
						attTSR[6], attTSR[7], attTSR[8],
						attTSR[3], attTSR[4], 1.0);
				attTSR[5] = 1.0;
				obj.getTRS().setValues(temp.getValues());
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		
		JPanel scaleZRow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		scaleZRow.add(scaleZLabel);
		scaleZRow.add(modifyScaleZ);
		
		add(scaleZRow);
	}
	
	//private JPanel setScale(double[] att, int axis)
	//{
	//	
	//}
	
	
	public void setRenderPanel(JPanel renderPanel) {this.renderPanel = renderPanel;}
	public void setObject(Object3D obj) 
	{
		this.obj = obj;
		if (obj != null) showOptions();
		else showDisabled();
	}
	public void setScene(Scene scene) {this.scene = scene;}
}
