	private void setSettingsMenu(JMenu SettingsMenu)
	{
		var sMenuItem = new JMenuItem("Scene Settings");
		sMenuItem.setToolTipText("Set the scene's properties");
		sMenuItem.addActionListener(e->{
			var sceneDialog = new JDialog((Frame)null, "Scene settings", true);
			
			var tt = new JPanel();
			tt.setLayout(new BoxLayout(tt, BoxLayout.Y_AXIS));
			
			var bck = new JPanel();
			var amb = new JPanel();
			var btns = new JPanel();
			
			var backgroundLabel = new JLabel("Background Color");
			var colorPicker = new JButton();
			
			var og = new ImageIcon("res/icons/paintbucket.png");
			Image image = og.getImage();
			var scaledImage = image.getScaledInstance(64, 64, Image.SCALE_SMOOTH);
			var scaledIcon = new ImageIcon(scaledImage);
			
			colorPicker.setIcon(scaledIcon);
			
			colorPicker.addActionListener(ev -> {
				var color = JColorChooser.showDialog(this, 
						"Choose background's color", scene.getBackgroundColor());
				if (color != null)
				{scene.setBackgroundColor(color);
				renderPanel.repaint();}
			});
			
			var ambientLabel = new JLabel("Ambient light");
			var ambX = new JTextField(5);
			ambX.setText(String.valueOf(scene.getIa().getColor().getRed()));
			ambX.addActionListener(a -> {
				try {
					scene.getIa().setColor( new Color(
							Integer.parseInt(ambX.getText()),
							scene.getIa().getColor().getGreen(),
							scene.getIa().getColor().getBlue(),
							scene.getIa().getColor().getAlpha()
							));
					ambX.setText(String.valueOf(scene.getIa().getColor().getRed()));
				}catch (Exception ex)
				{
					ambX.setText(String.valueOf(scene.getIa().getColor().getRed()));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			
			var ambY = new JTextField(5);
			ambY.setText(String.valueOf(scene.getIa().getColor().getGreen()));
			ambY.addActionListener(a -> {
				try {
					scene.getIa().setColor( new Color(
							scene.getIa().getColor().getRed(),
							Integer.parseInt(ambY.getText()),
							scene.getIa().getColor().getBlue(),
							scene.getIa().getColor().getAlpha()
							));
					ambY.setText(String.valueOf(scene.getIa().getColor().getGreen()));
				}catch (Exception ex)
				{
					ambY.setText(String.valueOf(scene.getIa().getColor().getGreen()));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			
			var ambZ = new JTextField(5);
			ambZ.setText(String.valueOf(scene.getIa().getColor().getBlue()));
			ambZ.addActionListener(a-> {
				try {
					scene.getIa().setColor( new Color(
							scene.getIa().getColor().getRed(),
							scene.getIa().getColor().getGreen(),
							Integer.parseInt(ambZ.getText()),
							scene.getIa().getColor().getAlpha()
							));
					ambZ.setText(String.valueOf(scene.getIa().getColor().getBlue()));
				}catch (Exception ex)
				{
					ambZ.setText(String.valueOf(scene.getIa().getColor().getBlue()));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			
			var okBtn = new JButton("OK");
			okBtn.addActionListener(a -> {
				try 
				{
					scene.getIa().setColor( new Color(
							Integer.parseInt(ambX.getText()),
							Integer.parseInt(ambY.getText()),
							Integer.parseInt(ambZ.getText()),
							scene.getIa().getColor().getAlpha()
							));
				}catch (Exception ex){}
				
				renderPanel.repaint();
				sceneDialog.dispose();
			});
			var cancelBtn = new JButton("Cancel");
			cancelBtn.addActionListener(a->{sceneDialog.dispose();});
			
			sceneDialog.setSize(400, 320);
			
			bck.add(backgroundLabel);
			bck.add(colorPicker);
			
			tt.add(bck);
			
			amb.add(ambientLabel);
			amb.add(ambX);
			amb.add(ambY);
			amb.add(ambZ);
			
			tt.add(amb);
			
			btns.add(okBtn);
			btns.add(cancelBtn);
			
			tt.add(btns);
			
			sceneDialog.setContentPane(tt);
			sceneDialog.setVisible(true);
		});
		
		var cMenuItem = new JMenuItem("Camera Settings");
		cMenuItem.setToolTipText("Set the camera's properties");
		cMenuItem.addActionListener(e-> {
			//ms, rs, proj
			var sceneDialog = new JDialog((Frame)null, "Camera settings", true);
			
			var tt = new JPanel();
			tt.setLayout(new BoxLayout(tt, BoxLayout.Y_AXIS));
			
			var ms = new JPanel();
			var msLabel = new JLabel("Movement speed:");
			var msS = new JTextField(5);
			msS.setText(String.valueOf(km.getSpeed()));
			msS.addActionListener(a-> {
				try
				{
					double speed = Double.parseDouble(msS.getText());
					speed = (speed < 0.0)? 0.1 : speed;
					km.setSpeed(speed);
					msS.setText(String.valueOf(speed));
				}catch (Exception ex) {}
			});
			ms.add(msLabel);
			ms.add(msS);
			
			var rs = new JPanel();
			var rsLabel = new JLabel("Rotation speed:");
			var rsS = new JTextField(5);
			rsS.setText(String.valueOf(mm.getSensitivity()));
			rsS.addActionListener(a->{
				try
				{
					double sensitivity = Double.parseDouble(rsS.getText());
					sensitivity = (sensitivity < 0.0) ? 0.1: sensitivity;
					mm.setSensitivity(sensitivity);
					rsS.setText(String.valueOf(sensitivity));
				}catch (Exception ex) {}
			});
			rs.add(rsLabel);
			rs.add(rsS);
			
			var pt = new JPanel();
			var ptLabel = new JLabel("Projection type:");
			
			pt.add(ptLabel);
			
			var btns = new JPanel();
			var okBtn = new JButton("OK");
			okBtn.addActionListener(a->{
				try
				{
					double speed = Double.parseDouble(msS.getText());
					speed = (speed<0.0)?0.1:speed;
					km.setSpeed(speed);
				}catch (Exception ex) {}
				try
				{
					double sensitivity = Double.parseDouble(rsS.getText());
					sensitivity = (sensitivity <0.0)?0.1:sensitivity;
					mm.setSensitivity(sensitivity);
				}catch(Exception ex) {}
				sceneDialog.dispose();
			});
			var cancelBtn = new JButton("Cancel");
			cancelBtn.addActionListener(a->{
				sceneDialog.dispose();
			});
			btns.add(okBtn);
			btns.add(cancelBtn);
			
			tt.add(ms);
			tt.add(rs);
			tt.add(pt);
			tt.add(btns);
			
			sceneDialog.setSize(400, 320);
			sceneDialog.setContentPane(tt);
			sceneDialog.setVisible(true);
		});
		var rMenuItem = new JMenuItem("Rendering Settings");
		rMenuItem.setToolTipText("Set rendering properties");
		rMenuItem.addActionListener(e->{
			
		});
		
		SettingsMenu.add(sMenuItem);
		SettingsMenu.add(cMenuItem);
		SettingsMenu.add(rMenuItem);

	}
