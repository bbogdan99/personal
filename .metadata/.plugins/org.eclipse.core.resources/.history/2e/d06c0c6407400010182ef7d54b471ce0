	private void setFileMenu(JMenu FileMenu)
	{
		var lMenuItem = new JMenuItem("Load Object from File");
		lMenuItem.setToolTipText("Render an object from a file");
		lMenuItem.addActionListener( e -> {
			var fileChooser = new JFileChooser();
			
			var filter = new FileNameExtensionFilter("Object files", "obj");
			fileChooser.addChoosableFileFilter(filter);
			
			int ret = fileChooser.showDialog(this, "Open file");
			
			if (ret == JFileChooser.APPROVE_OPTION)
			{
				var file = fileChooser.getSelectedFile().getAbsolutePath();
				FileReader fR = new FileReader();
				fR.readFile(file, 2);
				scene.addObject(fR.getObject());
				
				renderPanel.repaint();
			}
		});
		
		var sMenuItem = new JMenuItem("Screenshot scene");
		sMenuItem.setToolTipText("Take a screenshot of the scene");
		sMenuItem.addActionListener( e -> {
			var formatter = DateTimeFormatter.ISO_TIME;
			var lTime = Instant.ofEpochMilli(e.getWhen()).atZone(ZoneId.systemDefault()).toLocalTime();
			String name = "screenshot"+lTime.format(formatter).replace(":", "-") + ".png";
			
			BufferedImage image = new BufferedImage(renderPanel.getWidth(), renderPanel.getHeight(), BufferedImage.TYPE_INT_RGB);
			
			Graphics2D g2d = image.createGraphics();
		    renderPanel.paint(g2d);
		    g2d.dispose();

		    try {
		        File output = new File("res/screenshots/" + name);
		        ImageIO.write(image, "png", output);
		    } catch (IOException ex) {
		        ex.printStackTrace();
		    }
		});
		
		var eMenuItem = new JMenuItem("Exit");
		eMenuItem.setToolTipText("Exit the program");
		eMenuItem.addActionListener(e-> System.exit(0));
		
		FileMenu.add(lMenuItem);
		FileMenu.add(sMenuItem);
		FileMenu.add(eMenuItem);
	}
