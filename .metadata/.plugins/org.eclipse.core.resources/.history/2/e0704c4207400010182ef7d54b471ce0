	private JPanel colorOption()
	{
		JPanel colorRow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		//obj.getMaterial().getColor();
		
		var colorLabel = new JLabel("Color:");
		colorLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		colorLabel.setForeground(new Color(50,50,25));
		
		var redModify = new JTextField(5);
		redModify.setText(String.valueOf(obj.getMaterial().getColor().getRed()));
		redModify.setToolTipText("Set the RED part of the RGB");
		redModify.addActionListener(e->{
			try
			{
				float red = Float.parseFloat(redModify.getText());
				red = (red > 255.0f) ? 255.0f: red;
				red = (red < 0.0f) ? 0.0f: red;
				redModify.setText(String.valueOf(red));
				
				obj.getMaterial().setColor(new Color((int)red,
						obj.getMaterial().getColor().getBlue(), 
						obj.getMaterial().getColor().getGreen()));
				
			} catch (Exception ex)
			{
				redModify.setText(String.valueOf(obj.getMaterial().getColor().getRed()));
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		var greenModify = new JTextField(5);
		greenModify.setText(String.valueOf(obj.getMaterial().getColor().getGreen()));
		greenModify.setToolTipText("Set the GREEN part of the RGB");
		greenModify.addActionListener(e->{
			try
			{
				float green = Float.parseFloat(greenModify.getText());
				green = (green > 255.0f) ? 255.0f: green;
				green = (green < 0.0f) ? 0.0f: green;
				greenModify.setText(String.valueOf(green));
				
				obj.getMaterial().setColor(new Color(
						obj.getMaterial().getColor().getRed(),
						(int)green,
						obj.getMaterial().getColor().getBlue()
						));
				
			} catch (Exception ex)
			{
				greenModify.setText(String.valueOf(obj.getMaterial().getColor().getGreen()));
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		
		var blueModify = new JTextField(5);
		blueModify.setText(String.valueOf(obj.getMaterial().getColor().getBlue()));
		blueModify.setToolTipText("Set the BLUE part of the RGB");
		blueModify.addActionListener(e->{
			try
			{
				float blue = Float.parseFloat(blueModify.getText());
				blue = (blue > 255.0f) ? 255.0f: blue;
				blue = (blue < 0.0f) ? 0.0f: blue;
				blueModify.setText(String.valueOf(blue));
				
				obj.getMaterial().setColor(new Color(
						obj.getMaterial().getColor().getRed(),
						obj.getMaterial().getColor().getGreen(),
						(int)blue));
				
			} catch (Exception ex)
			{
				blueModify.setText(String.valueOf(obj.getMaterial().getColor().getBlue()));
			}
			finally
			{
				renderPanel.repaint();
			}
		});
		
		
		var colorPicker = new JButton();
		colorPicker.addActionListener(e -> {
			var color = JColorChooser.showDialog(this, 
					"Choose object's color", obj.getMaterial().getColor());
			obj.getMaterial().setColor(color);
			redModify.setText(String.valueOf(color.getRed()));
			blueModify.setText(String.valueOf(color.getBlue()));
			greenModify.setText(String.valueOf(color.getGreen()));
			renderPanel.repaint();
		});
		
		colorRow.add(colorLabel);
		colorRow.add(colorPicker);
		colorRow.add(redModify);
		colorRow.add(greenModify);
		colorRow.add(blueModify);
		
		return colorRow;
	}
	
	
	
	private double clampK(double ka)
	{
		if (ka <0.0) return 0.0;
		if (ka >1.0) return 1.0;
		return ka;
	}
	private double clampB(double B)
	{
		if (B <1.0) return 1.0;
		if (B >256.0) return 256.0;
		return B;
	}
	public void setRenderPanel(JPanel renderPanel) {this.renderPanel = renderPanel;}
	public void setObject(Object3D obj) 
	{
		this.obj = obj;
		if (obj != null) showOptions();
		else showDisabled();
	}
	public void setScene(Scene scene) {this.scene = scene;}
}
