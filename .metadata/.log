            double tAC = ACp/AC;
            
            UV uv_2 = new UV(tri.getUV1().getU() + tAB * (tri.getUV2().getU() - tri.getUV1().getU()),
            		tri.getUV1().getV() + tAB * (tri.getUV2().getV() - tri.getUV1().getV()));
            UV uv_3 = new UV(tri.getUV1().getU() + tAC * (tri.getUV3().getU() - tri.getUV1().getU()),
