	private double clampK(double ka)
	{
		if (ka <0.0) return 0.0;
		if (ka >1.0) return 1.0;
		return ka;
	}
	private double clampB(double B)
	{
		if (B <1.0) return 1.0;
		if (B >256.0) return 256.0;
		return B;
	}
