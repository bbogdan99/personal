    private static UV getUV(Vertex )
    
    private static double SegmentLength(Vertex A, Vertex B)
    {
    	return Math.sqrt(
    			(A.getX() - B.getX()) * (A.getX() - B.getX()) +
    			(A.getY() - B.getY()) * (A.getY() - B.getY()) +
    			(A.getZ() - B.getZ()) * (A.getZ() - B.getZ())
