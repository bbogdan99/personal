					double X = Double.parseDouble(modifyTranslateA.getText());
					modifyTranslateA.setText(String.valueOf(X));
					
					Matrix4 temp = new Matrix4(X, att[1], att[2],
							att[6], att[7], att[8],
							att[3], att[4], att[5]);
					att[0] = X;
					obj.getTRS().setValues(temp.getValues());
				} catch (Exception ex)
				{
					ex.printStackTrace();
					modifyTranslateA.setText(String.valueOf(att[0]));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			break;
		case 'Y':
			translateALabel.setText("Translate y:");
			modifyTranslateA.setText(String.valueOf(y));
			
			modifyTranslateA.addActionListener(e -> {
				try
				{
					double Y = Double.parseDouble(modifyTranslateA.getText());
					modifyTranslateA.setText(String.valueOf(Y));
					
					Matrix4 temp = new Matrix4(att[0], Y, att[2],
							att[6], att[7], att[8],
							att[3], att[4], att[5]);
					att[1] = Y;
					obj.getTRS().setValues(temp.getValues());
				} catch (Exception ex)
				{
					ex.printStackTrace();
					modifyTranslateA.setText(String.valueOf(att[1]));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			break;
		case 'Z':
			translateALabel.setText("Translate z:");
			modifyTranslateA.setText(String.valueOf(z));
			
			modifyTranslateA.addActionListener(e -> {
				try
				{
					double Z = Double.parseDouble(modifyTranslateA.getText());
					modifyTranslateA.setText(String.valueOf(Z));
					
					Matrix4 temp = new Matrix4(att[0], att[1], Z,
							att[6], att[7], att[8],
							att[3], att[4], att[5]);
					att[2] = Z;
					obj.getTRS().setValues(temp.getValues());
				} catch (Exception ex)
				{
					ex.printStackTrace();
					modifyTranslateA.setText(String.valueOf(att[2]));
				}
				finally
				{
					renderPanel.repaint();
				}
			});
			break;
		default:
			translateALabel.setText("Undefined axis for translation");
			break;
		}
		
		JPanel TranslateARow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		TranslateARow.add(translateALabel);
		TranslateARow.add(modifyTranslateA);
		return TranslateARow;
	}
	
	private JPanel reflectOption(double[] att)
	{
		JLabel reflectLabel = new JLabel("Reflect on: ");
		reflectLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		reflectLabel.setForeground(new Color(50,50,25));
		
		var reflectX = new JButton("X");
		reflectX.addActionListener(e-> {
			Matrix4 temp = new Matrix4(att[0], att[1], att[2],
					att[6], att[7], att[8],
					(-1.0 * att[3]), att[4], att[5]);
			att[3] = (-1.0 * att[3]);
			obj.getTRS().setValues(temp.getValues());
			
			renderPanel.repaint();
		});
		
		var reflectY = new JButton("Y");
		reflectY.addActionListener(e->{
			Matrix4 temp = new Matrix4(att[0], att[1], att[2],
					att[6], att[7], att[8],
					att[3], (-1.0 * att[4]), att[5]);
			att[4] = (-1.0 * att[4]);
			obj.getTRS().setValues(temp.getValues());
			
			renderPanel.repaint();
		});
		
		var reflectZ = new JButton("Z");
		reflectZ.addActionListener(e->{
			Matrix4 temp = new Matrix4(att[0], att[1], att[2],
					att[6], att[7], att[8],
					att[3], att[4], (-1.0 * att[5]));
			att[5] = (-1.0 * att[5]);
			obj.getTRS().setValues(temp.getValues());
			
			renderPanel.repaint();
		});
		
		JPanel reflect = new JPanel();
		reflect.add(reflectLabel);
		reflect.add(reflectX);
		reflect.add(reflectY);
		reflect.add(reflectZ);
		return reflect;
	}
	
	private JPanel kakdOption()
