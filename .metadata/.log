			}
		});
		
		MaterialRow.add(ksLabel);
		MaterialRow.add(ksmodify);
		
		MaterialRow.add(BLabel);
		MaterialRow.add(Bmodify);
		
		return MaterialRow;
	}
	
	private JPanel colorOption()
	{
		JPanel colorRow = new JPanel(new FlowLayout(FlowLayout.LEFT));
		//obj.getMaterial().getColor();
		
		var colorLabel = new JLabel("Color:");
		colorLabel.setFont(new Font("Serif", Font.PLAIN, 12));
		colorLabel.setForeground(new Color(50,50,25));
		
		var redModify = new JTextField(5);
		redModify.setText(String.valueOf(obj.getMaterial().getColor().getRed()));
